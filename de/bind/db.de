; BIND reverse data file for empty rfc1918 zone
;
; DO NOT EDIT THIS FILE - it is used for multiple zones.
; Instead, copy it, edit named.conf, and use that copy.
;
$TTL 7200
@	IN	SOA	f.nic.de. dns-operations.denic.de. (
		 1781084920		; Serial
			   7200		; Refresh
			   7200		; Retry
			3600000		; Expire
			   7200 )	; Negative Cache TTL
;

@                     21600   IN      NS      n.de.net.
@                     21600   IN      NS      a.nic.de.
@                     21600   IN      NS      f.nic.de.
@                     21600   IN      NS      z.nic.de.
@                     21600   IN      NS      s.de.net.
@                     21600   IN      NS      l.de.net.

